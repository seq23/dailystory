{
  "imports": {
    "#types/": "./supabase/functions/_shared/types/"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "lib": ["dom", "dom.asynciterable", "es2022"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}