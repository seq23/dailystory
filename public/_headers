# Bulletproof Security Headers Configuration
/*
  # Unified Content Security Policy - Single source of truth
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.lovable.dev https://*.lovable.app https://*.gptengineer.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cpzeuogomaixamrtnnmj.supabase.co https://im.runware.ai; connect-src 'self' wss://ws-api.runware.ai https://*.runware.ai https://*.elevenlabs.io https://*.lovable.dev https://*.lovable.app https://*.gptengineer.app https://cpzeuogomaixamrtnnmj.supabase.co ws://localhost:* ws://127.0.0.1:* ws://0.0.0.0:*; font-src 'self' data:; media-src 'self' data: blob:; frame-ancestors 'self' https://*.lovable.dev https://*.lovable.app https://*.gptengineer.app; base-uri 'self'; form-action 'self'; object-src 'none'
  
  # Enhanced Security Headers - Allow Lovable iframe communication
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # Additional Security - Allow Lovable cross-origin communication
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Embedder-Policy: unsafe-none
